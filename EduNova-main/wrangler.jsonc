{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edunova",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://edunova.app",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "edunova-ac27f",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "edunova-ac27f.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "edunova-ac27f.firebasestorage.app"
  }
}
